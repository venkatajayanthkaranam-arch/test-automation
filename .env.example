# =============================================================
# Oracle Fusion Cloud - Instance & Credentials
# Fill in your instance details below, OR leave blank and type
# credentials directly in the Web UI each time.
# =============================================================

ORACLE_BASE_URL=https://your-pod.fa.ocs.oraclecloud.com
ORACLE_USERNAME=your.username@domain.com
ORACLE_PASSWORD=your_password_here

# =============================================================
# Google Cloud / Vertex AI (Gemini) - AI interpretation engine
# Download your service account JSON from GCP Console and place
# it at: config/gcp_service_account.json
# =============================================================
GCP_PROJECT_ID=your-gcp-project-id
GCP_LOCATION=us-central1
GCP_SERVICE_ACCOUNT_JSON=config/gcp_service_account.json
GEMINI_MODEL=gemini-1.5-pro

# =============================================================
# Browser Settings
# Options: chromium, chrome, firefox, webkit, msedge
# =============================================================
BROWSER=chromium
HEADLESS=false
